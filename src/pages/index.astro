---
import "../styles/main.css";

const heading = "Syringe Games";
const subheading =
  "Thank you for being part of Syringe Games! 💕 The event has come to an end, and the Syringe Games app is now officially closed.";

const appIcon = "/images/app-icon.webp";
const appScreenshot = "/images/app-screenshot.webp";

const contacts = [
  {
    name: "Facebook",
    label: "34th Syringe Games",
    link: "https://www.facebook.com/people/34th-Syringe-Games/100089421965360/",
  },
  {
    name: "Instagram",
    label: "@34th_syringe",
    link: "https://www.instagram.com/34th_syringe/",
  },
  {
    name: "TikTok",
    label: "@34th_syringe",
    link: "https://www.tiktok.com/@34th_syringe",
  },
];

const pageTitle = "Syringe Games";
const favicon = "/images/favicon.ico";
const today = new Date();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Thank you for being part of Syringe Games! The app is now officially closed."
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="container">
      <main>
        <div class="text-container">
          <img src={appIcon} width={80} height={80} alt="App Icon" class="app-icon" />
          <h1 class="heading">{heading}</h1>
          <h2 class="subheading">{subheading}</h2>
          <p class="authors">Made with &#x2665; by IT Division of SMCU</p>
        </div>
        <div>
          <img src={appScreenshot} width={220} height={1080 / 529 * 220} alt="App Screenshot" class="app-screenshot" />
        </div>
      </main>
      <footer>
        &copy; {today.getFullYear()} Docchula. All rights reserved.
        <div class="social-links">
          {
            contacts.map((contact) => (
              <a href={contact.link} target="_blank" rel="noopener noreferrer">
                <span class="sr-only">Follow on {contact.name}</span>
              </a>
            ))
          }
        </div>
      </footer>
    </div>
  </body>
</html>